{
  "name": "perception-launcher",
  "version": "1.0.0",
  "description": "High-Performance Bloxd.io Client",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder build --win --publish never",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "bloxd",
    "electron",
    "performance"
  ],
  "author": "the0Archivist",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.perception.launcher",
    "productName": "Perception Launcher",
    "win": {
      "target": "nsis",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!node_modules/*",
      "!.github/*",
      "!.git/*"
    ]
  }
}
